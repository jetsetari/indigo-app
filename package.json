{
  "name": "indigo",
  "version": "1.1.1",
  "main": "index.ts",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "start": "npx expo start",
    "android": "npx expo run:android",
    "ios": "npx expo run:ios",
    "dev:clean": "expo start --clear",
    "prebuild-clean": "rm -rf node_modules ios android yarn.lock && yarn install && npx expo prebuild",
    "patch-ios": "node scripts/patch-ios.js",
    "patch-android": "node scripts/patch-android.js",
    "patch-all": "yarn patch-ios && yarn patch-android",
    "ios-ready": "yarn prebuild-clean && cd ios && pod install",
    "android-ready": "yarn prebuild-clean && yarn patch-android",
    "android:bundle": "cd android && ./gradlew clean && ./gradlew bundleRelease",
    "build-ios": "eas build --platform ios",
    "submit-ios": "eas submit --platform ios",
    "build-android": "eas build --platform android",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.2.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/native": "^7.1.13",
    "@react-navigation/native-stack": "^7.3.18",
    "@supabase/supabase-js": "^2.56.1",
    "add": "^2.0.6",
    "base64-arraybuffer": "^1.0.2",
    "dayjs": "^1.11.13",
    "dotenv": "^17.2.1",
    "expo": "~54.0.0",
    "expo-audio": "~1.0.16",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.11",
    "expo-font": "~14.0.10",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.9",
    "expo-linear-gradient": "~15.0.8",
    "expo-media-library": "~18.2.1",
    "expo-status-bar": "~3.0.9",
    "expo-video": "~3.0.15",
    "lottie-react-native": "~7.3.1",
    "prop-types": "^15.8.1",
    "react": "19.1.0",
    "react-hook-form": "^7.62.0",
    "react-native": "0.81.5",
    "react-native-is-edge-to-edge": "^1.2.1",
    "react-native-picker-select": "^9.3.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-toast-message": "^2.3.3",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-uuid": "^2.0.3",
    "react-native-webview": "13.15.0",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "typescript": "~5.9.2"
  },
  "private": true,
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
