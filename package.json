{
  "name": "indigo",
  "version": "1.0.1",
  "main": "index.ts",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "start": "npx expo start",
    "android": "npx expo run:android",
    "ios": "npx expo run:ios",
    "dev:clean": "expo start --clear",
    "prebuild-clean": "rm -rf node_modules ios android yarn.lock && yarn install && npx expo prebuild",
    "patch-ios": "node scripts/patch-ios.js",
    "patch-android": "node scripts/patch-android.js",
    "patch-all": "yarn patch-ios && yarn patch-android",
    "ios-ready": "yarn prebuild-clean && yarn patch-ios && cd ios && pod install",
    "android-ready": "yarn prebuild-clean && yarn patch-android",
    "android:bundle": "cd android && ./gradlew clean && ./gradlew bundleRelease",
    "build-ios": "eas build --platform ios",
    "submit-ios": "eas submit --platform ios",
    "build-android": "eas build --platform android"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@hookform/resolvers": "^5.2.1",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/datetimepicker": "8.4.1",
    "@react-native-picker/picker": "^2.11.1",
    "@react-navigation/native": "^7.1.13",
    "@react-navigation/native-stack": "^7.3.18",
    "@supabase/supabase-js": "^2.56.1",
    "add": "^2.0.6",
    "base64-arraybuffer": "^1.0.2",
    "dayjs": "^1.11.13",
    "dotenv": "^17.2.1",
    "expo": "53.0.22",
    "expo-audio": "~0.4.9",
    "expo-camera": "^16.1.10",
    "expo-constants": "^17.1.6",
    "expo-font": "~13.3.2",
    "expo-image-manipulator": "^13.1.7",
    "expo-image-picker": "^16.1.4",
    "expo-linear-gradient": "^14.1.5",
    "expo-media-library": "^17.1.7",
    "expo-status-bar": "~2.2.3",
    "expo-video": "~2.2.2",
    "lottie-react-native": "7.2.2",
    "prop-types": "^15.8.1",
    "react": "19.0.0",
    "react-hook-form": "^7.62.0",
    "react-native": "0.79.5",
    "react-native-is-edge-to-edge": "^1.2.1",
    "react-native-picker-select": "^9.3.1",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-toast-message": "^2.3.3",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-uuid": "^2.0.3",
    "react-native-webview": "13.13.5",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.0.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "typescript": "~5.8.3"
  },
  "private": true,
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
